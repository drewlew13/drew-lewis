---
import type { Entry } from '../data/schema';

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;

// Organisation, team and location read as one line; the last two may be absent,
// so they are joined rather than separated by hard-coded punctuation.
const meta = [entry.organisation, entry.context, entry.location]
  .filter(Boolean)
  .join(' · ');
---

<article id={entry.slug} class="scroll-mt-8">
  <div class="flex flex-col gap-x-6 gap-y-1 sm:flex-row sm:items-baseline sm:justify-between">
    <h3 class="text-base font-semibold text-ink">{entry.title}</h3>
    <p class="shrink-0 text-sm text-ink-muted tabular-nums">
      {entry.start} – {entry.end}
    </p>
  </div>

  <p class="mt-1 text-sm text-ink-muted">{meta}</p>

  <ul class="mt-3 list-disc space-y-2 pl-5 text-sm/6 text-ink-muted marker:text-accent">
    {entry.highlights.map((highlight) => (
      <li>{highlight}</li>
    ))}
  </ul>
</article>
