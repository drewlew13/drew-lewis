---
import type { Link } from '../data/schema';

interface Props {
  links: Link[];
}

const { links } = Astro.props;

const isEmail = (href: string) => href.startsWith('mailto:');
---

{/* Plain anchors: a row of links needs no client-side JavaScript (Article 4).
    The visible label carries the accessible name; the description extends it
    for screen readers rather than replacing it. Generic icons rather than brand
    marks, which avoids shipping third-party logos (Article 5) — an envelope for
    the mail link and an outbound arrow for the rest, because "opens your mail
    app" and "leaves this site" are different promises. */}
<ul class="flex flex-wrap gap-3">
  {links.map((link) => (
    <li>
      <a
        href={link.href}
        rel={isEmail(link.href) ? undefined : 'noopener noreferrer'}
        class="group inline-flex items-center gap-2 rounded-full border border-border bg-surface-raised px-4 py-2 text-sm font-medium text-ink transition-colors hover:border-accent hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        {link.label}
        <span class="sr-only">— {link.description}</span>
        <svg
          aria-hidden="true"
          viewBox="0 0 16 16"
          class="h-3.5 w-3.5 shrink-0 text-ink-muted transition-colors group-hover:text-accent"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          {isEmail(link.href) ? (
            <Fragment>
              <rect x="1.75" y="3.75" width="12.5" height="8.5" rx="1.5" />
              <path d="m2.5 4.9 5.5 3.9 5.5-3.9" />
            </Fragment>
          ) : (
            <Fragment>
              <path d="M5.5 10.5 10.5 5.5" />
              <path d="M6.5 5.5h4v4" />
            </Fragment>
          )}
        </svg>
      </a>
    </li>
  ))}
</ul>
